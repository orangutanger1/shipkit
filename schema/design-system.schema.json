		"type": {
			"type": "object",
			"required": [
				"family",
				"ramp"
			],
			"additionalProperties": false,
			"properties": {
				"family": {
					"type": "object",
					"required": [
						"text"
					],
					"additionalProperties": false,
					"properties": {
						"text": {
							"type": "string"
						},
						"display": {
							"type": "string"
						},
						"mono": {
							"type": "string"
						}
					}
				},
				"ramp": {
					"type": "array",
					"minItems": 4,
					"items": {
						"type": "object",
						"required": [
							"name",
							"size",
							"lineHeight",
							"weight",
							"cite"
						],
						"additionalProperties": false,
						"properties": {
							"name": {
								"type": "string",
								"pattern": "^[a-z][a-zA-Z0-9]*$"
							},
							"size": {
								"type": "number",
								"minimum": 8
							},
							"lineHeight": {
								"type": "number",
								"minimum": 8
							},
							"weight": {
								"type": "integer",
								"minimum": 100,
								"maximum": 900
							},
							"tracking": {
								"type": "number"
							},
							"role": {
								"type": "string"
							},
							"cite": {
								"$ref": "#/$defs/citation"
							}
						}
					}
				}
			}
		},
		"spacing": {
			"type": "object",
			"required": [
				"base",
				"scale",
				"cite"
			],
			"additionalProperties": false,
			"properties": {
				"base": {
					"enum": [
						4,
						8
					],
					"description": "A single series. Mixed 4pt and 6pt spacing is why generated layouts read as noisy."
				},
				"scale": {
					"type": "array",
					"minItems": 4,
					"uniqueItems": true,
					"items": {
						"type": "number",
						"minimum": 0
					}
				},
				"cite": {
					"$ref": "#/$defs/citation"
				}
			}
		},
		"radii": {
			"type": "object",
			"minProperties": 1,
