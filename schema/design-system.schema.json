							"properties": {
								"background": {
									"type": "object",
									"required": [
										"value",
										"cite"
									],
									"additionalProperties": false,
									"properties": {
										"value": {
											"type": "string",
											"pattern": "^#[0-9a-fA-F]{6}$"
										},
										"cite": {
											"$ref": "#/$defs/citation"
										},
										"note": {
											"type": "string",
											"maxLength": 200
										}
