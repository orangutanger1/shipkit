						],
						"additionalProperties": false,
						"properties": {
							"value": {
								"type": "string",
								"minLength": 1
							},
							"cite": {
								"$ref": "#/$defs/citation"
							},
							"note": {
								"type": "string",
								"maxLength": 200
							}
						}
					}
				},
				"reducedMotion": {
					"type": "string",
					"maxLength": 300,
					"description": "What the system does when the OS asks for reduced motion. Required reading for the implementing agent; a missing answer means it will animate anyway."
				}
			}
		},
		"haptics": {
			"type": "object",
			"description": "Keyed by \"<flow>.<verb>\" so the haptics map speaks the same vocabulary as analytics.",
			"patternProperties": {
				"^(first-launch|welcome|value-prop|personalization|permission|account|first-value|home|navigation|search|discovery|detail|create|edit|settings|paywall|trial|upsell|feature-gate|pricing|restore|re-engagement|notification|streak|progress|reminder|empty|loading|error|offline|undo|destructive)\\.(viewed|started|completed|skipped|dismissed|failed|granted|denied)$": {
					"type": "object",
					"required": [
						"value",
						"cite"
					],
					"additionalProperties": false,
					"properties": {
						"value": {
							"enum": [
								"selection",
								"impactLight",
								"impactMedium",
								"impactHeavy",
								"success",
								"warning",
								"error"
							]
						},
						"cite": {
							"$ref": "#/$defs/citation"
						},
						"note": {
							"type": "string",
							"maxLength": 200
						}
					}
				}
			},
			"additionalProperties": false
		}
	}
