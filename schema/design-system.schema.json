{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/mayfield/shipkit/schema/design-system.schema.json",
	"title": "design system",
	"description": "design/system.json — the token contract. The implementing agent may not use a colour, radius, duration or type step that is not in this file, which is what makes a generated app look designed rather than assembled.",
	"type": "object",
	"required": [
		"brand",
		"color",
		"type",
		"spacing",
		"radii",
		"motion"
	],
	"additionalProperties": false,
	"patternProperties": {
		"^_": {
			"description": "Annotation kept beside the data it explains. Ignored by every loader."
		}
	},
	"$defs": {
		"citation": {
			"type": "string",
			"pattern": "^(ref_[0-9a-f]{6,32}|claim_[0-9a-z-]{1,40}|HIG:[A-Za-z0-9./-]+)$",
			"description": "Where this value comes from: a reference id, a patterns.json claim id, or a HIG rule. `ship design system --check` fails an uncited token — an invented colour is the failure mode this whole file exists to stop."
		}
	},
	"properties": {
		"$schema": {
			"type": "string"
		},
		"generatedAt": {
			"type": "string",
			"format": "date-time"
		},
		"brand": {
			"type": "object",
			"required": [
				"name",
				"direction"
			],
			"additionalProperties": false,
			"properties": {
				"name": {
					"type": "string",
					"minLength": 1
				},
				"direction": {
					"type": "string",
					"minLength": 1,
					"maxLength": 200,
					"description": "The one-sentence design direction every token answers to."
				},
				"rationale": {
					"type": "string",
					"maxLength": 2000
				}
			}
		},
		"color": {
			"type": "object",
			"required": [
				"accentHue",
				"themes"
			],
			"additionalProperties": false,
			"properties": {
				"accentHue": {
					"type": "integer",
					"minimum": 0,
					"maximum": 359,
					"description": "Exactly one accent hue. Multiple accents is the most common tell of a generated interface, so the schema permits only one."
				},
				"themes": {
					"type": "object",
					"required": [
						"light",
						"dark"
					],
					"additionalProperties": false,
					"properties": {
						"light": {
							"type": "object",
							"required": [
								"background",
								"surface",
								"surfaceAlt",
								"text",
								"textMuted",
