{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/mayfield/shipkit/schema/research-reviews.schema.json",
	"title": "research review corpus",
	"description": "Raw reviews for one app at research/<slug>/reviews/<trackId>.json. Deterministically fetched from the public RSS feed; never agent-edited.",
	"type": "object",
	"required": [
		"trackId",
		"fetchedAt",
		"sorts",
		"count",
		"reviews"
	],
	"additionalProperties": false,
	"patternProperties": {
		"^_": {
			"description": "Annotation kept beside the data it explains. Ignored by every loader."
		}
	},
	"properties": {
		"$schema": {
			"type": "string"
		},
		"trackId": {
			"type": "integer",
			"minimum": 1
		},
		"country": {
			"type": "string",
			"pattern": "^[a-z]{2}$"
		},
		"fetchedAt": {
			"type": "string",
			"format": "date-time"
		},
		"sorts": {
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": {
				"enum": [
					"mostrecent",
					"mosthelpful"
				]
			}
		},
		"count": {
			"type": "integer",
			"minimum": 0,
			"description": "reviews.length after cross-sort dedupe by id."
		},
		"appMeanRating": {
			"type": "number",
			"minimum": 0,
			"maximum": 5,
			"description": "Storefront lifetime mean, the baseline themes.ratingSkew is measured against."
		},
		"reviews": {
			"type": "array",
			"items": {
				"type": "object",
				"required": [
					"id",
					"rating",
					"date",
					"title",
					"body"
				],
				"additionalProperties": false,
				"properties": {
					"id": {
						"type": "string",
						"minLength": 1
					},
					"rating": {
						"type": "integer",
						"minimum": 1,
						"maximum": 5
					},
					"version": {
						"type": [
							"string",
							"null"
						]
					},
					"date": {
						"type": "string",
						"format": "date-time"
					},
					"title": {
						"type": "string"
					},
					"body": {
						"type": "string"
					},
					"sort": {
						"enum": [
							"mostrecent",
							"mosthelpful"
						]
					}
				}
			}
		}
	}
}
