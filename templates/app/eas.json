{
	"cli": {
		"version": ">= 5.0.0",
		"appVersionSource": "local"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"channel": "development",
			"env": {
				"APP_VARIANT": "development"
			},
			"ios": {
				"simulator": false
			}
		},
		"preview": {
			"distribution": "internal",
			"channel": "preview",
			"ios": {
				"simulator": false
			}
		},
		"simulator": {
			"ios": {
				"simulator": true
			}
		},
		"production": {
			"autoIncrement": true,
			"channel": "production"
		}
	},
	"submit": {
		"production": {
			"ios": {
				"bundleIdentifier": "__BUNDLE_ID__"
			}
		}
	}
}
