{
	"name": "shipkit",
	"version": "1.0.0",
	"private": true,
	"description": "One pipeline for shipping iOS apps: research → build → ship → grow",
	"type": "module",
	"bin": {
		"ship": "./bin/ship"
	},
	"engines": {
		"node": ">=20"
	},
	"files": [
		"bin",
		"src",
		"mcp",
		"skills",
		"templates",
		"ci"
	],
	"scripts": {
		"test": "node --test test/*.test.mjs",
		"test:c8": "c8 --100 --reporter=text --reporter=json --include 'src/**' --include 'bin/**' node --test test/*.test.mjs",
		"lint": "npx --yes oxlint@latest src bin",
		"typecheck": "tsc --noEmit",
		"metrics": "node scripts/metrics.mjs",
		"dup": "jscpd src bin",
		"deadcode": "knip",
		"mutation": "stryker run",
		"check": "npm run lint && npm run typecheck && npm run test:c8 && npm run metrics && npm run dup && npm run deadcode"
	},
	"devDependencies": {
		"@stryker-mutator/core": "^10.0.0",
		"@types/node": "^26.4.0",
		"acorn": "^8.18.0",
		"c8": "^12.0.0",
		"jscpd": "^5.1.1",
		"knip": "^6.34.0",
		"typescript": "^7.0.2"
	}
}
